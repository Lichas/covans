{
  "name": "covan",
  "version": "0.1.0",
  "private": true,
  "description": "Covan — 多 Bot 智能体聊天桌面应用",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "smoke": "node scripts/run-smoke.mjs",
    "test:ui": "npm run build && node scripts/ui-smoke.mjs",
    "test:context": "npm run build && node scripts/context-ui.mjs",
    "test:local-llm": "npm run build && node scripts/local-llm-smoke.mjs",
    "pack": "electron-builder --mac --dir"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.85.0",
    "@earendil-works/pi-ai": "^0.85.0",
    "better-sqlite3": "^11.10.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "zustand": "^5.0.1"
  }
}
